<script>
(function(){
  function esc(t){var d=document.createElement('div');d.textContent=String(t==null?'':t);return d.innerHTML}
  // the record: never covered by the fog
  fetch('ledger.json').then(function(r){return r.json()}).then(function(d){
    var p=d.projections||[]; var c={};
    p.forEach(function(x){c[x.status]=(c[x.status]||0)+1});
    var briers=[]; p.forEach(function(x){
      if(x.status==='hit'||x.status==='miss'){
        var f=parseInt(x.probability,10)/100, o=(x.status==='hit')?1:0;
        briers.push((f-o)*(f-o));}});
    var brier=briers.length?briers.reduce(function(a,b){return a+b},0)/briers.length:null;
    function S(id,v){var el=document.getElementById(id); if(el) el.textContent=v}
    S('b-issued',p.length); S('b-open',c.open||0);
    S('b-hm',(c.hit||0)+'H / '+(c.miss||0)+'M');
    S('b-brier',brier!==null?brier.toFixed(3):'—'); S('b-void',c.void||0);
    S('b-asof','Live · '+briers.length+' resolved'+(briers.length<30?' · under the noise floor':''));
    // the record, on the front page: last three verdicts
    var res=p.filter(function(x){return x.status==='hit'||x.status==='miss'});
    res.sort(function(a,b){
      var da=a.resolved_date||'', db=b.resolved_date||'';
      if(da!==db) return da<db?1:-1;
      var ia=a.id||'', ib=b.id||'';
      return ia===ib?0:(ia<ib?1:-1);
    });
    var ul=document.getElementById('verdicts');
    if(ul){
      ul.innerHTML='';
      res.slice(0,3).forEach(function(x){
        var li=document.createElement('li');
        var st=String(x.statement||'');
        li.innerHTML='<span class="vid">'+esc(x.id)+'</span>'+
          '<span class="tag '+(x.status==='hit'?'hit':'miss')+'">'+esc(x.status.toUpperCase())+' @ '+esc(x.probability)+'%</span>'+
          esc(st.length>110?st.slice(0,107)+'…':st);
        ul.appendChild(li);
      });
      if(!res.length) ul.innerHTML='<li class="pend">nothing resolved yet — the seals are set</li>';
    }
    // depth to signal
    var n=res.length, fill=document.getElementById('tiefe-fill'), tn=document.getElementById('tiefe-n');
    if(fill) fill.style.width=Math.min(100,(n/30)*100)+'%';
    if(tn) tn.textContent=n+' / 30 resolved';
  }).catch(function(){
    var el=document.getElementById('b-asof');
    if(el) el.textContent='Full record on the ledger';
  });
  // the commitment seal, computed live from the ledger the reader is holding
  fetch('ledger.json').then(function(r){return r.arrayBuffer()}).then(function(buf){
    if(!(window.crypto&&crypto.subtle)) throw 0;
    return crypto.subtle.digest('SHA-256',buf);
  }).then(function(h){
    var hex=Array.from(new Uint8Array(h)).map(function(b){return b.toString(16).padStart(2,'0')}).join('');
    var run=document.getElementById('siegel-run');
    var line='COMMITMENT SEAL \u00b7 SHA-256(ledger.json) = '+hex+' \u00b7 SEALED BEFORE OUTCOME \u00b7 EDITING ANY FORECAST BREAKS THIS NUMBER \u00b7 ';
    if(run) run.textContent=line+line;
  }).catch(function(){
    var run=document.getElementById('siegel-run');
    if(run) run.textContent='COMMITMENT SEAL \u00b7 SHA-256 published in commit history \u00b7 SEALED BEFORE OUTCOME \u00b7 ';
  });
  fetch('war_desk.json').then(function(r){return r.json()}).then(function(d){
    var g=d.grades||{}; var el=document.getElementById('b-wd');
    if(el) el.textContent=(g.A||0)+'A / '+(g.B||0)+'B';
    var lv=document.getElementById('wd-live');
    if(lv){
      var st=d.statements||{};
      lv.innerHTML='Live: <b>'+(g.A||0)+'A / '+(g.B||0)+'B</b> kinetic · <b>'+
        ((st.A||0)+(st.B||0))+'</b> statements confirmed';
    }
    var t3=document.getElementById('wd-top3');
    if(t3){
      var rows=[];
      if(d.top3 && d.top3.length){
        d.top3.slice(0,3).forEach(function(e){
          rows.push('<span class="g">'+esc(e.grade)+'</span>'+esc(e.anchor)+
                    ' <span class="z">· '+esc(e.sides)+' sides</span>');
        });
      } else if(d.top_confirmed){
        rows.push('<span class="g">A</span>'+esc(d.top_confirmed.anchor)+
                  ' <span class="z">· '+(d.top_confirmed.sides||'—')+' sides</span>');
      }
      t3.innerHTML=rows.join('<br>');
    }
  }).catch(function(){});
  // reveal
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);}});
    },{threshold:.12});
    document.querySelectorAll('.rv').forEach(function(el){io.observe(el)});
  } else {
    document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')});
  }
})();
</script>


<script>
(function(){
var BEAM_OFFSET = 0; /* degrees; nudge if paint leads or lags the light */
var SWEEP_MS = 22000;
var svgNS='http://www.w3.org/2000/svg';
var g=document.getElementById('contacts'); var beam=document.querySelector('.beam');
var tick=document.getElementById('scope-ticker');
if(!g)return;
var CAT=[
 ['battleship \u00b7 dreadnought era','sea',0.013,'<path d="M-11,0 L-8,-2.4 L8,-2.4 L11,0 L8,2.4 L-8,2.4 Z"/><circle cx="-5" cy="0" r="1.3"/><circle cx="0" cy="0" r="1.3"/><circle cx="6" cy="0" r="1.3"/>'],
 ['carrier \u00b7 straight deck, prop age','sea',0.012,'<path d="M-11,-2.6 L11,-2.6 L11,2.6 L-11,2.6 Z"/><rect x="4" y="-4" width="3" height="1.6"/>'],
 ['carrier \u00b7 angled deck, jet age','sea',0.015,'<path d="M-11,-3 L9,-3 L11,-1 L11,3 L-7,3 L-11,1 Z"/><rect x="3" y="-4.4" width="3" height="1.6"/>'],
 ['cruiser','sea',0.018,'<path d="M-9,0 L-6.5,-1.8 L6.5,-1.8 L9,0 L6.5,1.8 L-6.5,1.8 Z"/><circle cx="-3" cy="0" r="1.1"/><circle cx="3.5" cy="0" r="1.1"/>'],
 ['destroyer','sea',0.022,'<path d="M-7,0 L-5,-1.4 L5,-1.4 L7,0 L5,1.4 L-5,1.4 Z"/><circle cx="0" cy="0" r="1"/>'],
 ['submarine \u00b7 surfaced','sea',0.010,'<path d="M-8,0 Q0,-2.2 8,0 Q0,2.2 -8,0 Z"/><rect x="-1" y="-2.6" width="2" height="1.8"/>'],
 ['biplane','air',0.045,'<g fill="none" stroke-width="1.1"><path d="M-5,-2 L5,-2 M-4,1 L4,1 M0,-2 L0,3 M-1.6,3 L1.6,3"/></g>'],
 ['fighter \u00b7 prop age','air',0.07,'<path d="M0,-8 L1.2,-2.2 L1.2,5.5 L0,8 L-1.2,5.5 L-1.2,-2.2 Z"/><path d="M-8,-.5 L-1.2,-1.6 L-1.2,1.4 Z"/><path d="M8,-.5 L1.2,-1.6 L1.2,1.4 Z"/><path d="M-3,6.4 L3,6.4 L0,5.2 Z"/>'],
 ['fighter \u00b7 swept wing','air',0.10,'<path d="M0,-8 L1,-2 L1,6 L0,7.5 L-1,6 L-1,-2 Z"/><path d="M-7.5,4.5 L-1,-1 L-1,1.8 Z"/><path d="M7.5,4.5 L1,-1 L1,1.8 Z"/>'],
 ['interceptor \u00b7 delta','air',0.12,'<path d="M0,-7.5 L5.5,5.5 L0,3.6 L-5.5,5.5 Z"/>'],
 ['helicopter','air',0.035,'<ellipse cx="0" cy="1" rx="2" ry="3"/><g fill="none"><path d="M0,1 L0,7 M-1.4,7 L1.4,7" stroke-width="1.1"/><path d="M-6,-5 L6,7 M-6,7 L6,-5" stroke-width=".8" opacity=".8"/></g>'],
 ['submarine \u00b7 submerged','sub',0.008,'<path d="M-7,0 Q0,-1.7 7,0 Q0,1.7 -7,0 Z"/><rect x="-0.8" y="-3.1" width="1.6" height="2.1"/><path d="M0,-3.1 L0,-5" stroke-width=".8"/>'],
 ['submarine \u00b7 running deep','sub',0.006,'<path d="M-6,0 Q0,-1.5 6,0 Q0,1.5 -6,0 Z"/><path d="M0,-2.6 L0,-4.2" stroke-width=".7"/>']
];
var PHRASES=['FATE UNKNOWN','CREATE YOUR FATE','THE PROPHET BOARD','SEALED \u00b7 ADJUDICATED \u00b7 SCORED'];
var tickTimer=null;
function say(t,hold,hot){if(!tick)return;tick.textContent=t;
 tick.setAttribute('class',hot?'ticker hot':'ticker');
 tick.style.opacity=hot?'.95':'.6';
 clearTimeout(tickTimer);tickTimer=setTimeout(function(){tick.style.opacity='0';
  tick.setAttribute('class','ticker');},hold||3200);}
var idleI=0; setInterval(function(){if(tick&&tick.style.opacity==='0'){say(PHRASES[idleI++%PHRASES.length],2600);}},11000);
var contacts=[]; var departures=0;
function spawn(){
 var idx=Math.floor(Math.random()*CAT.length);
 var a=Math.random()*360, r=78+Math.random()*104;
 var t=(a-90)*Math.PI/180;
 var c={cls:CAT[idx], x:200+r*Math.cos(t), y:200+r*Math.sin(t),
  heading:Math.random()*360, speed:CAT[idx][2]*(0.7+Math.random()*0.7),
  maxO:0.70+Math.random()*0.30, born:performance.now(),
  rot:(CAT[idx][1]==='air'?0:-90), sub:(CAT[idx][1]==='sub'),
  phase:Math.random()*6.28,
  life:SWEEP_MS*(2+Math.random()*2), dying:0, el:document.createElementNS(svgNS,'g')};
 c.el.setAttribute('fill','var(--messing3,#dcb65e)');
 c.el.setAttribute('stroke','var(--messing3,#dcb65e)');
 c.el.setAttribute('stroke-width','1.15');
 c.el.setAttribute('opacity','0');
 c.el.innerHTML=c.cls[3]+'<title>'+c.cls[0]+' \u00b7 fate unknown</title>';
 g.appendChild(c.el); contacts.push(c);
 if(Math.random()<0.22)say('CREATE YOUR FATE',3200,true);
}
function depart(c){
 if(c.dying)return; c.dying=performance.now(); departures++;
 if(departures%7===0)say('FATE-ALITY',3800,true);
 else if(Math.random()<0.18)say('FATE UNKNOWN',3000,true);
 var wait=800+Math.random()*8200;
 setTimeout(function(){if(contacts.length<12)spawn();},wait);
}
var N=7+Math.floor(Math.random()*4);
for(var i=0;i<N;i++)spawn();
var reduced=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
if(reduced){contacts.forEach(function(c){c.el.setAttribute('opacity','0.4');
 c.el.setAttribute('transform','translate('+c.x+','+c.y+') rotate('+(c.heading+c.rot)+') scale(1.55)');});return;}
var t0=performance.now(), last=t0;
function beamAngle(now){
 if(beam){var tr=getComputedStyle(beam).transform;
  var mm=tr&&tr!=='none'&&tr.match(/matrix\(([-\d.e]+),\s*([-\d.e]+)/);
  if(mm)return (Math.atan2(parseFloat(mm[2]),parseFloat(mm[1]))*180/Math.PI+360+BEAM_OFFSET)%360;}
 return (((now-t0)/SWEEP_MS)*360+BEAM_OFFSET)%360;
}
function loop(now){
 var dt=Math.min(50,now-last); last=now;
 var ang=beamAngle(now);
 for(var i=contacts.length-1;i>=0;i--){
  var c=contacts[i];
  var h=(c.heading-90)*Math.PI/180;
  c.x+=Math.cos(h)*c.speed*dt; c.y+=Math.sin(h)*c.speed*dt;
  var dx=c.x-200, dy=c.y-200, rr=Math.sqrt(dx*dx+dy*dy);
  if(!c.dying&&(rr>188||rr<62||now-c.born>c.life))depart(c);
  var aCur=(Math.atan2(dy,dx)*180/Math.PI+90+360)%360;
  var trail=((ang-aCur)%360+360)%360;
  var o=trail<10?c.maxO:c.maxO*Math.pow(0.5,trail/52);
  if(o<0.11)o=0.11;
  if(c.sub){var ph=Math.sin((now-c.born)/3300+c.phase); o*=(ph>0.30?1:0.10);}
  if(c.dying){var f=1-(now-c.dying)/1500; if(f<=0){c.el.remove();contacts.splice(i,1);continue;} o*=f;}
  c.el.setAttribute('opacity',o.toFixed(2));
  c.el.setAttribute('transform','translate('+c.x.toFixed(1)+','+c.y.toFixed(1)+') rotate('+(c.heading+c.rot)+') scale(1.55)');
 }
 requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
})();
</script>

</body></html>
